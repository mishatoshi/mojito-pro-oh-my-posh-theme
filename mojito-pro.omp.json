{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#A3F5B5",
          "style": "plain",
          "template": "\u250c ",
          "type": "text"
        },
        {
          "foreground": "#F66555",
          "style": "plain",
          "template": "\uf0e7 ",
          "type": "root"
        },
        {
          "foreground": "#A3F5B5",
          "style": "plain",
          "template": "{{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "type": "os"
        },
        {
          "foreground": "#A3F5B5",
          "style": "plain",
          "template": "{{ .UserName }} ",
          "type": "session"
        },
        {
          "foreground": "#A3F5B5",
          "options": {
            "folder_icon": "\ue5fe",
            "folder_separator_template": " \u00bb ",
            "home_icon": "\ueb06",
            "style": "agnoster"
          },
          "style": "plain",
          "template": "<#A3F5B5>::</> \ue5ff {{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "#EDDF5E",
          "options": {
            "branch_icon": "\ue725 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "plain",
          "template": "<#A3F5B5>::</> {{ .HEAD }}{{ if .Staging.Changed }}<#70DB86> \uf044 {{ .Staging.String }}</>{{ end }}{{ if .Working.Changed }}<#5DADEF> \uf044 {{ .Working.String }}</>{{ end }} ",
          "type": "git"
        },
        {
          "foreground": "#A9D775",
          "options": {
            "fetch_version": true
          },
          "style": "plain",
          "template": "<#A3F5B5>::</> \ue781 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "node"
        },
        {
          "foreground": "#5DADEF",
          "options": {
            "display_mode": "files",
            "fetch_version": true
          },
          "style": "plain",
          "template": "<#A3F5B5>::</> \ue73d {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "php"
        },
        {
          "foreground": "#EDDF5E",
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          },
          "style": "plain",
          "template": "<#A3F5B5>::</> \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "python"
        },
        {
          "foreground": "#F66555",
          "style": "plain",
          "template": "<#A3F5B5>::</> \ue738 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "java"
        },
        {
          "foreground": "#5AE0F2",
          "options": {
            "fetch_version": true
          },
          "style": "plain",
          "template": "<#A3F5B5>::</>  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "go"
        },
        {
          "foreground": "#F0682D",
          "style": "plain",
          "template": "<#A3F5B5>::</> \ue7a8 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "type": "rust"
        },
        {
          "foreground": "#A3F5B5",
          "options": {
            "time_format": "02/01/06 15:04"
          },
          "style": "plain",
          "template": "<#A3F5B5>::</> \uf073 {{ .CurrentDate | date .Format }} ",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#A3F5B5",
          "style": "plain",
          "template": "\u2514",
          "type": "text"
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#A3F5B5",
          "template": " \ueba2 {{ .FormattedMs }} ",
          "options": {
            "threshold": 500,
            "style": "austin",
            "always_enabled": true
          }
        },
        {
          "foreground": "#A3F5B5",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#F66555{{ end }}"
          ],
          "options": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "\u276f\u276f",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{if .Root}}[root] {{end}}{{.Shell}} in <{{.Folder}}>",
  "final_space": true,
  "version": 4
}
